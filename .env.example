# PostgreSQL
POSTGRES_DB=sparking_licenses
POSTGRES_USER=sparking
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://sparking:CHANGE_ME@db:5432/sparking_licenses

# Core secrets - use long random values
ADMIN_TOKEN=CHANGE_ME
LICENSE_HASH_SECRET=CHANGE_ME

# License behavior
OFFLINE_GRACE_HOURS=72
ACTIVATION_BIND_FINGERPRINT=true
ENABLE_DOCS=false

# Discord bot. Leave DISCORD_TOKEN empty if you do not want the bot yet.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
# Optional dedicated API key. If empty, the bot temporarily uses ADMIN_TOKEN.
DISCORD_API_TOKEN=
