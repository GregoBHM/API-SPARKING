# PostgreSQL
POSTGRES_DB=sparking_licenses
POSTGRES_USER=sparking
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://sparking:CHANGE_ME@db:5432/sparking_licenses

# Core secrets - generate your own long random values
ADMIN_TOKEN=CHANGE_ME
LICENSE_HASH_SECRET=CHANGE_ME

# License behavior
OFFLINE_GRACE_HOURS=72
ACTIVATION_BIND_FINGERPRINT=true
ENABLE_DOCS=false
USER_ACTIVATION_RESET_COOLDOWN_HOURS=24

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=
# Recommended: a dedicated key created from POST /admin/api-keys.
# If empty, the bot falls back to ADMIN_TOKEN.
DISCORD_API_TOKEN=

# Presence / appearance
DISCORD_STATUS=online
DISCORD_ACTIVITY_TYPE=watching
DISCORD_ACTIVITY_TEXT=SparkingCraft Licenses
DISCORD_BRAND_NAME=SparkingCraft License Manager

# v2 migration: true removes old guild slash commands before syncing /product, /license, /my, /system.
# After the first successful deployment you may change this to false.
DISCORD_CLEAN_SLASH_ON_START=true
